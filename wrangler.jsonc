{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotelrajmahalpalace-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hotelrajmahalpalace-admin"
    }
  ],
  "routes": [
    {
      "pattern": "admin.hotelrajmahalpalace.in/*",
      "zone_name": "hotelrajmahalpalace.in"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://toqcichgylvlzxzyhled.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://toqcichgylvlzxzyhled.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_3ZEw-XUy7Y1-ewEx9x7qow_lNsG0b7d"
  },
  "observability": {
    "enabled": true
  }
}
