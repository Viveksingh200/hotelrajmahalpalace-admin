{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotelrajmahalpalace-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hotelrajmahalpalace-admin"
    }
  ],
  "routes": [
    {
      "pattern": "admin.hotelrajmahalpalace.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
